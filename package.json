{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/check-pm.mjs",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --filter \"./scripts\" --if-present run typecheck",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/api-server exec tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "pnpm --filter @workspace/api-server exec tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/scripts/seed.ts"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.5",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
